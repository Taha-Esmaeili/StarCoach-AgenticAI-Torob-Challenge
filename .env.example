# ============================================================================
# 1. TypeSafe AI System One (Jev) & OpenAI-Compatible LLM / Embedding API Keys
# ============================================================================
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=10.0

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=20.0

# Optional separate embedding credentials (defaults to LLM_BASE_URL / LLM_API_KEY if empty)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=128

# ============================================================================
# 2. PostgreSQL + pgvector & Redis Connections, Pools & Cache TTLs
# ============================================================================
POSTGRES_USER=torob
POSTGRES_PASSWORD=torob_secret
POSTGRES_DB=torob_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://torob:torob_secret@localhost:5432/torob_db
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_COMMAND_TIMEOUT_SECONDS=15.0

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_KEY_PREFIX=torob
REDIS_SESSION_TTL_SECONDS=21600
REDIS_PROFILE_TTL_SECONDS=86400
REDIS_QCACHE_TTL_SECONDS=300

# ============================================================================
# 3. 15-Parameter Adaptive RecSys & Anti-Fatigue Hyperparameters
# ============================================================================
RECSYS_TOTAL_SLOTS=15
RECSYS_BASE_SLOTS=5
RECSYS_PERSONA_SLOTS=5
RECSYS_DYNAMIC_SLOTS=5

RECSYS_DEFAULT_BASE_WEIGHTS_JSON={"w_distance":0.50,"w_price":0.60,"w_score":0.40,"w_open_now":0.50,"w_freshness":0.40}
RECSYS_DEFAULT_PERSONA_WEIGHTS_JSON={"w_installment":0.30,"w_warranty":0.40,"w_mall_cluster":0.30,"w_verified_shop":0.35,"w_delivery_backup":0.25}

RECSYS_FUSION_GAMMA=0.85
RECSYS_FUSION_ALPHA_MIN=0.15
RECSYS_FUSION_ALPHA_MAX=0.95
RECSYS_EMA_LEARNING_RATE=0.25
RECSYS_DYNAMIC_SLOT_DECAY_LAMBDA=0.15

RECSYS_DEDUP_COSINE_HIGH_THRESHOLD=0.80
RECSYS_DEDUP_COSINE_LOW_THRESHOLD=0.65
RECSYS_DEDUP_JEV_NOUL_THRESHOLD=0.65

RECSYS_CLARIFY_CONFIDENCE_THRESHOLD=0.45
RECSYS_DISSATISFIED_NOUL_THRESHOLD=0.70
RECSYS_MAX_CLARIFICATION_ROUNDS=2

RECSYS_DEALBREAKER_NOUL_THRESHOLD=0.70
RECSYS_HURDLE_PENALTY_MULTIPLIER=0.15

RECSYS_TRAVEL_COST_PER_KM_TOMAN=15000
RECSYS_TRAVEL_COUPLING_LAMBDA=0.20
RECSYS_FRESHNESS_HALF_LIFE_DAYS=14.0
RECSYS_BAYESIAN_PRIOR_VOTES=10

# ============================================================================
# 4. Geolocation, Tehran Bounding Box, Retrieval Limits & Server Settings
# ============================================================================
DEFAULT_USER_ID=usr_tehran_default
DEFAULT_USER_LAT=35.7219
DEFAULT_USER_LNG=51.3347
TEHRAN_LAT_MIN=35.40
TEHRAN_LAT_MAX=35.95
TEHRAN_LNG_MIN=51.00
TEHRAN_LNG_MAX=51.75
DEFAULT_SEARCH_RADIUS_KM=15.0
MAX_CANDIDATE_OFFERS=50
TOP_RANKED_STORES_LIMIT=10

TOROB_DATASET_DIR=./dataset
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=*
HOST=0.0.0.0
PORT=8000

# ============================================================================
# 5. Frontend (Vite / React 19 UI_Template) Environment Variables
# ============================================================================
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_API_BASE_PATH=/api/v1
VITE_DEFAULT_USER_ID=usr_tehran_default
VITE_DEFAULT_LAT=35.7219
VITE_DEFAULT_LNG=51.3347
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
